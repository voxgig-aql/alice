# av viewer: unit tests for viewer/av-doc.aql (document → row model).
#
# Run from the repo root:
#   aql test/av_doc_unit_test.aql


import "aql:test" end
import "./viewer/av-doc.aql" end


# Fixture documents, at top level (aql check treats test bodies as
# opaque; the leading underscore marks body-only defs).

def _doc {name: "ada", tags: ["x", "y"], meta: {age: 36, ok: true}}
def _deep {a: {b: {c: [1, {d: 2}]}}, z: 5}
def _lines ["first", "second", "", "fourth"]


# --- top: root plus one expanded level ------------------------------

[
  def rows (AvDoc.top (_doc))
  4 (size (rows)) Assert.equal end
  true  ((rows get 0) get "open") Assert.equal end
  "map" ((rows get 0) get "kind") Assert.equal end
  0     (size ((rows get 0) get "path")) Assert.equal end
  "meta" ((rows get 1) get "key") Assert.equal end
  "map"  ((rows get 1) get "kind") Assert.equal end
  2      ((rows get 1) get "n") Assert.equal end
  "name" ((rows get 2) get "key") Assert.equal end
  "leaf" ((rows get 2) get "kind") Assert.equal end
  "tags" ((rows get 3) get "key") Assert.equal end
  "list" ((rows get 3) get "kind") Assert.equal end
] "top-shape" Test.test end


# --- top of a scalar document is a single leaf row ------------------

[
  def rows (AvDoc.top 42)
  1 (size (rows)) Assert.equal end
  "leaf" ((rows get 0) get "kind") Assert.equal end
] "top-scalar" Test.test end


# --- expand splices child rows in place -----------------------------

[
  def rows (AvDoc.top (_doc))
  def rows2 (AvDoc.expand (_doc) (rows) 1)
  6 (size (rows2)) Assert.equal end
  true ((rows2 get 1) get "open") Assert.equal end
  "age" ((rows2 get 2) get "key") Assert.equal end
  2     ((rows2 get 2) get "depth") Assert.equal end
  "ok"  ((rows2 get 3) get "key") Assert.equal end
  "name" ((rows2 get 4) get "key") Assert.equal end
] "expand-splice" Test.test end


# --- expand is a no-op on open rows and leaves ----------------------

[
  def rows (AvDoc.top (_doc))
  def rows2 (AvDoc.expand (_doc) (rows) 1)
  true ((AvDoc.expand (_doc) (rows2) 1) deq (rows2)) Assert.equal end
  true ((AvDoc.expand (_doc) (rows2) 4) deq (rows2)) Assert.equal end
] "expand-noop" Test.test end


# --- collapse inverts expand ----------------------------------------

[
  def rows (AvDoc.top (_doc))
  def rows2 (AvDoc.expand (_doc) (rows) 1)
  def rows3 (AvDoc.collapse (rows2) 1)
  true ((rows3) deq (rows)) Assert.equal end
  true ((AvDoc.collapse (rows3) 1) deq (rows)) Assert.equal end
] "collapse-inverts" Test.test end


# --- subtree-end ----------------------------------------------------

[
  def rows (AvDoc.top (_doc))
  def rows2 (AvDoc.expand (_doc) (rows) 1)
  4 (AvDoc.subtree-end (rows2) 1) Assert.equal end
  6 (AvDoc.subtree-end (rows2) 0) Assert.equal end
  3 (AvDoc.subtree-end (rows2) 2) Assert.equal end
  6 (AvDoc.subtree-end (rows2) 5) Assert.equal end
] "subtree-end" Test.test end


# --- kids of a list row ---------------------------------------------

[
  def rows (AvDoc.top (_doc))
  def ks (AvDoc.kids (_doc) (rows get 3))
  2 (size (ks)) Assert.equal end
  0 ((ks get 0) get "key") Assert.equal end
  1 ((ks get 1) get "key") Assert.equal end
  "leaf" ((ks get 0) get "kind") Assert.equal end
  2 ((ks get 0) get "depth") Assert.equal end
] "kids-of-list" Test.test end


# --- value-at -------------------------------------------------------

[
  36 (AvDoc.value-at (_doc) ["meta", "age"]) Assert.equal end
  "y" (AvDoc.value-at (_doc) ["tags", 1]) Assert.equal end
  2 (AvDoc.value-at (_deep) ["a", "b", "c", 1, "d"]) Assert.equal end
  true ((AvDoc.value-at (_doc) ["meta", "nope"]) is None) Assert.equal end
  true ((AvDoc.value-at (_doc) ["tags", 9]) is None) Assert.equal end
  true ((AvDoc.value-at (_doc) ["tags", -1]) is None) Assert.equal end
  true ((AvDoc.value-at (_doc) ["name", "deeper"]) is None) Assert.equal end
] "value-at" Test.test end


# --- has-path -------------------------------------------------------

[
  true (AvDoc.has-path (_doc) []) Assert.equal end
  true (AvDoc.has-path (_doc) ["meta", "age"]) Assert.equal end
  true (AvDoc.has-path (_deep) ["a", "b", "c", 1, "d"]) Assert.equal end
  false (AvDoc.has-path (_doc) ["meta", "nope"]) Assert.equal end
  false (AvDoc.has-path (_doc) ["tags", 2]) Assert.equal end
  false (AvDoc.has-path (_doc) ["nope", "deep", "er"]) Assert.equal end
] "has-path" Test.test end


# --- parent ---------------------------------------------------------

[
  true ((AvDoc.parent ["a", "b"]) deq ["a"]) Assert.equal end
  0 (size (AvDoc.parent ["a"])) Assert.equal end
  0 (size (AvDoc.parent [])) Assert.equal end
] "parent" Test.test end


# --- display strings ------------------------------------------------

[
  ".meta.age" (AvDoc.path-str ["meta", "age"]) Assert.equal end
  ".tags[1]" (AvDoc.path-str ["tags", 1]) Assert.equal end
  "" (AvDoc.path-str []) Assert.equal end
] "path-str" Test.test end

[
  def rows (AvDoc.top (_doc))
  def rows2 (AvDoc.expand (_doc) (rows) 1)
  "" (AvDoc.key-str (rows2 get 0)) Assert.equal end
  "meta" (AvDoc.key-str (rows2 get 1)) Assert.equal end
  def ks (AvDoc.kids (_doc) (rows2 get 5))
  "[0]" (AvDoc.key-str (ks get 0)) Assert.equal end
] "key-str" Test.test end

[
  def rows (AvDoc.top (_doc))
  def rows2 (AvDoc.expand (_doc) (rows) 1)
  "{…} 2 keys" (AvDoc.value-str (_doc) (rows2 get 1)) Assert.equal end
  "[…] 2 items" (AvDoc.value-str (_doc) (rows2 get 5)) Assert.equal end
  "36" (AvDoc.value-str (_doc) (rows2 get 2)) Assert.equal end
  "true" (AvDoc.value-str (_doc) (rows2 get 3)) Assert.equal end
  "'ada'" (AvDoc.value-str (_doc) (rows2 get 4)) Assert.equal end
] "value-str" Test.test end


# --- search ---------------------------------------------------------

[
  def hits (AvDoc.search (_doc) "ada")
  1 (size (hits)) Assert.equal end
  true ((hits get 0) deq ["name"]) Assert.equal end
] "search-value-hit" Test.test end

[
  def hits (AvDoc.search (_doc) "age")
  1 (size (hits)) Assert.equal end
  true ((hits get 0) deq ["meta", "age"]) Assert.equal end
] "search-key-hit" Test.test end

[
  0 (size (AvDoc.search (_doc) "AGE")) Assert.equal end
  0 (size (AvDoc.search (_doc) "ADA")) Assert.equal end
] "search-smart-case" Test.test end

[
  def hits (AvDoc.search (_deep) "d")
  1 (size (hits)) Assert.equal end
  true ((hits get 0) deq ["a", "b", "c", 1, "d"]) Assert.equal end
] "search-deep-key" Test.test end


# --- expansion sets + rebuild ---------------------------------------

[
  def rows (AvDoc.top (_doc))
  def rows2 (AvDoc.expand (_doc) (rows) 1)
  def rows3 (AvDoc.expand (_doc) (rows2) 5)
  def exps (AvDoc.expanded-of (rows3))
  def rebuilt (AvDoc.rebuild (_doc) (exps))
  true ((rebuilt) deq (rows3)) Assert.equal end
] "rebuild-round-trip" Test.test end

[
  def rows (AvDoc.top (_doc))
  def exps (AvDoc.expanded-of (rows))
  def stale ((exps) set (AvDoc.path-key ["ghost", "node"]) true)
  def rebuilt (AvDoc.rebuild (_doc) (stale))
  true ((rebuilt) deq (rows)) Assert.equal end
] "rebuild-ignores-stale-paths" Test.test end


# --- text documents (a list of lines) -------------------------------

[
  def rows (AvDoc.top (_lines))
  5 (size (rows)) Assert.equal end
  "list" ((rows get 0) get "kind") Assert.equal end
  "'first'" (AvDoc.value-str (_lines) (rows get 1)) Assert.equal end
  "''" (AvDoc.value-str (_lines) (rows get 3)) Assert.equal end
] "text-doc-rows" Test.test end


# --- summary --------------------------------------------------------

"---" print
"fail count: " print Test.fail-count end print
0 Test.fail-count end Assert.equal end
"all green" print
