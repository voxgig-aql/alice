# alice viewer smoke test: every fixture format loads through AliceFmt and
# renders rows through AliceDoc without an error. No assertions — like
# test/bloom_smoke_test.aql, a clean end-to-end run is the pass.
#
# Run from the repo root:
#   aql test/alice_smoke_test.aql


import "./viewer/alice-fmt.aql" end
import "./viewer/alice-doc.aql" end


print "--- alice viewer smoke: load + rows for every fixture ---"

def _fixtures [
  "sample.json", "sample.jsonic", "sample.json5", "sample.jsonc",
  "sample.csv", "sample.tsv", "sample.toml", "sample.yaml",
  "sample.xml", "sample.ini", "sample.zon", "sample.md",
  "bad.json", "lines.txt"
]

def _walk (each [ var [[nm]
  def res (AliceFmt.load `test/fixtures/${nm}` {})
  def rows (if (res get "ok") [ AliceDoc.top (res get "doc") ] [ [] ])
  # expand the first expandable child row, then render every visible
  # row's key and value strings — the per-frame work the viewer does
  def rows2 (if ((size (rows)) gt 1) [ AliceDoc.expand (res get "doc") (rows) 1 ] [ (rows) ])
  def lines (each [ var [[rw]
    `${(AliceDoc.key-str (rw))}=${(AliceDoc.value-str (res get "doc") (rw))}`
  ]] (rows2))
  print (`${nm}: kind=${(res get "kind")} rows=${(size (rows2))}`)
  0
]] (_fixtures))

print "--- search sweep over the json fixture ---"
def _res (AliceFmt.load "test/fixtures/sample.json" {})
def _hits (AliceDoc.search (_res get "doc") "title")
print (`title hits: ${(size (_hits))}`)

print "all green"
